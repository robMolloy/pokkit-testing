{
  "name": "pokkit-starter-ts-testing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test-ui": "vitest --ui",
    "tsc": "node_modules/.bin/tsc --project ./tsconfig.json --noemit --watch",
    "attempt-kill-port": "kill -9 $(lsof -ti :\"$PORT\" 2>/dev/null | head -n 1) 2>/dev/null || true",
    "kill-port": "PORT=$PORT npm run attempt-kill-port",
    "get-platform-arch": "node -e \"console.log(process.platform + '_' + process.arch + (process.platform === 'win32' ? '.exe' : ''))\"",
    "dev1": "npm run test",
    "dev2": "npm run tsc"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.10",
    "@vitest/ui": "4.0.18",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@repo/pokkit-testing": "workspace:^",
    "pocketbase": "^0.26.6",
    "zod": "^4.3.6"
  }
}
