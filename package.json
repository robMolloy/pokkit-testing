{
  "name": "pokkit-testing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test-ui": "vitest --ui",
    "tsc": "node_modules/.bin/tsc --project ./tsconfig.json --noemit --watch",
    "attempt-kill-port": "kill -9 $(lsof -ti :\"$PORT\" 2>/dev/null | head -n 1) 2>/dev/null || true",
    "kill-port": "PORT=$PORT npm run attempt-kill-port",
    "kill:8090": "PORT=8090 npm run kill-port",
    "kill:8091": "PORT=8091 npm run kill-port",
    "db:init-dev": "cd pocketbase/app-db && go mod init app-db && go mod tidy",
    "db:serve-dev": "cd pocketbase/app-db && go run . serve --http=\"0.0.0.0:8090\"",
    "db:build": "cd pocketbase/app-db && go build && mkdir -p builds && mv app-db builds/app-db",
    "db:build:on-change-to-dev": "npx nodemon --delay 1 --watch pocketbase/app-db/main.go --exec \"npm run db:build\"",
    "app-db:start": "pocketbase/app-db/pocketbase_$(npm run -s get-platform-arch) serve --http=\"0.0.0.0:8090\"",
    "app-db:create-backup": "pocketbase/scripts/app-db-create-backup.mjs",
    "app-db:get-collections": "pocketbase/scripts/app-db-get-collections.mjs",
    "test-db:start": "./pocketbase/test-db/pocketbase_$(npm run -s get-platform-arch) serve --http=\"0.0.0.0:8091\" --hooksDir=\"pocketbase/app-db/pb_hooks\"",
    "test-db:clone-from-app-db-seed": "pocketbase/scripts/test-db-clone-from-app-db-seed.mjs",
    "test-db:clone-from-app-db-seed:watch": "npx nodemon --watch pocketbase/app-db/pb_migrations --watch pocketbase/app-db/pb_hooks --delay 2 --exec \"npm run test-db:clone-from-app-db-seed\" ",
    "get-platform-arch": "node -e \"console.log(process.platform + '_' + process.arch + (process.platform === 'win32' ? '.exe' : ''))\"",
    "dev1": "npm run db:serve-dev",
    "dev2": "npm run db:build:on-change-to-dev",
    "dev3": "",
    "dev4": "npm run test",
    "dev5": "npm run tsc"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.10",
    "@vitest/ui": "4.0.18",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "pocketbase": "^0.26.6",
    "zod": "^4.3.6"
  }
}
